# Contract address of the deployed VerificationEngine (test deployment on studionet)
MONITOR_CONTRACT=0xE5C9A821b0Fa27Fe8d8DE0e74a55C0fdc17760ff
# GenLayer RPC endpoint
MONITOR_RPC=https://studio.genlayer.com/api
# Poll interval in ms
MONITOR_POLL_MS=60000
# Webhook URL to POST change notifications (optional)
MONITOR_WEBHOOK_URL=
# Auto-reverify owned records within this many seconds of expiry
MONITOR_REVERIFY_THRESHOLD_S=86400
# Private key of an account that owns records you want auto-reverified (optional)
MONITOR_PRIVATE_KEY=
